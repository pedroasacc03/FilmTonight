# Copy this file to .env and fill in your own values.
# .env is git-ignored so your secrets never get committed.

# --- Anthropic (Claude) API key ---
# Required for: preference analysis, recommendation/Surprise Me candidate generation, and
# the chatbot. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model those three features use (lib/profile.js, lib/recommendations.js,
# lib/chat.js) - one tier for everything. A cheaper model (Haiku) was tried for chat/
# recommendations at one point, but removed after testing found it would occasionally claim
# to have made a data edit it never actually made - not an acceptable trade for a feature
# whose entire point is trustworthy read/write access to real data. Optional - defaults to
# claude-sonnet-5 if unset. Env var name predates this being the only tier.
CLAUDE_PROFILE_MODEL=claude-sonnet-5

# --- TMDB (The Movie Database) API key ---
# Required for: all title lookups (name search, genres, cast, streaming availability, etc,
# see lib/titles.js). Free - sign up at https://www.themoviedb.org, then generate a key at
# https://www.themoviedb.org/settings/api ("API Key (v3 auth)").
TMDB_API_KEY=your-tmdb-v3-api-key-here

# --- OMDb API key ---
# Optional. Used only for Rotten Tomatoes / IMDb scores (TMDB doesn't have these) - a title
# still works fine without it, it just won't show RT/IMDb scores. Free tier (1,000 requests/
# day) - get one at https://www.omdbapi.com/apikey.aspx.
OMDB_API_KEY=your-omdb-api-key-here

# --- Site URL ---
# Your public production URL (Railway domain or custom domain), no trailing slash. Used only
# for og:image/twitter:image resolution and other social-share meta tags (see app/layout.js,
# app/opengraph-image.js) - safe to leave at the localhost default while developing locally.
SITE_URL=http://localhost:3000

# --- Database ---
# SQLite file, stored locally on disk - zero setup required.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Used to sign session tokens (see lib/auth.js). Any long random string works.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-this-with-a-long-random-string

# --- Admin ---
# Comma-separated list of account emails allowed to view the internal metrics
# page (/admin/metrics - see lib/admin.js). Everyone else gets a "not
# authorized" message, even if signed in. No schema/DB flag needed - just
# edit this list. Leave unset/empty to disable the page for everyone.
ADMIN_EMAILS=you@example.com
